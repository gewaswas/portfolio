{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "public/**" }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index?__route=/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
