PORT=4000
# npm run dev starts a local MongoDB process with persistent storage.
# file is an optional local development fallback.
STORAGE_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/kbd_portfolio
# Optional override if your default DNS refuses Atlas SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Run npm run setup to create a private password in .env.
ADMIN_PASSWORD=
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
# Local default is disk. Set mongodb on Vercel; uploads are then stored in Atlas.
UPLOAD_STORAGE=disk
